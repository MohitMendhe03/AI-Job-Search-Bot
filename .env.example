# Copy to .env and fill in. Never share this file.
# Use EITHER of these two (Gemini has a free tier, no card):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Free job aggregator (request key at https://jooble.org/api/about)
JOOBLE_API_KEY=
# Adzuna (now paid) - leave empty
# Free job API for India (https://developer.adzuna.com) - optional but recommended
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Morning report on Telegram (optional): create bot via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
